# seekdb 的 @seekdb/default-embed 把 workspace 协议写进了 peerDependencies，
# npm 11 自动安装 peer 时会报 EUNSUPPORTEDPROTOCOL，因此固定该选项。
legacy-peer-deps=true

# 前端只用 onnxruntime-web（浏览器 WASM/WebGPU），
# 但 @huggingface/transformers 会连带安装 onnxruntime-node，其 postinstall 需要下载
# 平台二进制，在代理/离线环境里会直接失败。关掉安装脚本即可，浏览器侧不受影响。
ignore-scripts=true
