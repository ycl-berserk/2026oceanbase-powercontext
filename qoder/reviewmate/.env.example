# ReviewMate 本地配置示例。复制为 .env 后按需修改。
# 真实密钥只放在本机 .env，不提交到仓库。

# seekdb 数据目录（嵌入式运行）
REVIEWMATE_DB_PATH=data/seekdb/reviewmate.db

# 中文 embedding 模型（FastEmbed 本地运行，首次会下载模型）
REVIEWMATE_EMBED_MODEL=BAAI/bge-small-zh-v1.5
REVIEWMATE_EMBED_DIM=512
# REVIEWMATE_EMBED_CACHE=/home/you/.cache/fastembed

# 检索默认返回条数
REVIEWMATE_TOP_K=6

# PowerContext 服务地址
REVIEWMATE_POWERCONTEXT_URL=http://127.0.0.1:8100
REVIEWMATE_POWERCONTEXT_TIMEOUT=8

# LLM：auto = 有 DEEPSEEK_API_KEY 就调用，否则使用本地摘录模式
# 可选 auto / deepseek / off
REVIEWMATE_LLM_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 启动 PowerContext 时使用的数据库（与上面的服务配套）
POWERCONTEXT_SERVER_DATABASE_URL=sqlite+aiosqlite:////home/you/qoder-reviewmate/data/powercontext/reviewmate.db
